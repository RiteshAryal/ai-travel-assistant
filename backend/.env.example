# Qdrant Cloud URL, or ":memory:" for an in-process store (local dev, data lost on restart)
QDRANT_HOST=:memory:
QDRANT_API_KEY=
COLLECTION_NAME=travel_guides

# 'openai', 'gemini', 'ollama' (local server, no key) or 'huggingface' (local flan-t5-base, slow, no key)
MODEL_PROVIDER=gemini

# openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# gemini (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ollama (no key; run `ollama pull llama3.1:8b` first)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=20
